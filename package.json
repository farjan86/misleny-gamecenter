{
  "name": "tank-misleny",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "version": "node scripts/version.mjs",
    "build": "node scripts/version.mjs && tsc --noEmit && vite build && npm run server:build",
    "test": "vitest run",
    "map:fetch": "node scripts/fetch-osm.mjs",
    "map:buildings": "node scripts/fetch-buildings.mjs",
    "map:process": "node scripts/process-map.mjs",
    "map": "npm run map:fetch && npm run map:buildings && npm run map:process",
    "server:build": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs --external:ws --log-level=warning",
    "server": "npm run server:build && node dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
